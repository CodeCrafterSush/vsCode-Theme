    "editorCursor.foreground": "#ffffff",
    "editor.selectionBackground": "#1c2530",
    "editor.lineHighlightBackground": "#141b22",
    "editor.inactiveSelectionBackground": "#5f7a8770",
    "editor.selectionHighlightBackground": "#ffcc0020",
    "editor.selectionHighlightBorder": "#ffcc0020",
    "editor.wordHighlightBackground": "#4a4a7680",
    "editor.wordHighlightStrongBackground": "#6a6a9680",
    "editorBracketHighlight.foreground1": "#b267e6",
    "editorBracketHighlight.foreground2": "#e6db74",
    "editorBracketHighlight.foreground3": "#fd971f",
    "editorBracketHighlight.unexpectedBracket.foreground": "#ff1212cc",
    "editorBracketMatch.background": "#0f1419",
    "editorBracketMatch.border": "#ffcc0050",
    "editorError.foreground": "#ff6600",
    "editorWarning.foreground": "#c3e88d70",
    "editorWhitespace.foreground": "#ffffff20",
    "editorGutter.addedBackground": "#c3e88d60",
    "editorGutter.deletedBackground": "#ff537060",
    "editorGutter.modifiedBackground": "#82aaff60",
    "editorHoverWidget.background": "#0f1419",
    "editorHoverWidget.border": "#ffffff10",

    "tab.activeBackground": "#0f1419",
    "tab.inactiveBackground": "#0b1014",
    "tab.border": "#00000000",
    "tab.hoverBackground": "#0f1419",
    "tab.activeBorderTop": "#00000000",
    "tab.activeForeground": "#ffffff",
    "tab.inactiveForeground": "#5f7a87",
    "tab.unfocusedActiveBorder": "#5f7a87",
    "tab.unfocusedActiveForeground": "#ffffff",

    "editorGroup.border": "#00000000",
    "editorGroupHeader.tabsBackground": "#0b1014",
    "editorGroupHeader.noTabsBackground": "#0b1014",
    "editorGroup.dropBackground": "#9dff0080",

    "panel.background": "#0b1014",
    "panel.border": "#00000000",
    "sideBar.background": "#0b1014",
    "sideBar.border": "#00000000",
    "sideBar.foreground": "#5f7a87",
    "sideBarSectionHeader.background": "#0b1014",
    "sideBarTitle.foreground": "#ffffff",

    "activityBar.background": "#0b1014",
    "activityBar.border": "#00000000",
    "activityBar.foreground": "#ffffff",
    "activityBar.inactiveForeground": "#ffffff66",
    "activityBarBadge.background": "#9dff00",
    "activityBarBadge.foreground": "#000000",

    "statusBar.background": "#0b1014",
    "statusBar.border": "#00000000",
    "statusBar.foreground": "#5f7a87",
    "statusBar.debuggingBackground": "#c792ea",
    "statusBar.debuggingForeground": "#ffffff",

    "titleBar.activeBackground": "#0b1014",
    "titleBar.activeForeground": "#ffffff",
    "titleBar.border": "#00000000",
    "titleBar.inactiveBackground": "#0b1014",
    "titleBar.inactiveForeground": "#5f7a87",

    "list.activeSelectionBackground": "#5f7a8770",
    "list.activeSelectionForeground": "#9dff00",
    "list.focusBackground": "#ffffff20",
    "list.focusForeground": "#ffffff",
    "list.highlightForeground": "#9dff00",

    "notificationLink.foreground": "#9dff00",

    "scrollbar.shadow": "#0f141900",
    "scrollbarSlider.activeBackground": "#9dff0050",
    "scrollbarSlider.background": "#00000070",
    "scrollbarSlider.hoverBackground": "#00000030",

    "editorSuggestWidget.background": "#131a20",
    "editorSuggestWidget.foreground": "#cfd7e3",
    "editorSuggestWidget.selectedBackground": "#5f7a8770",
    "editorSuggestWidget.highlightForeground": "#9dff00"
  },

  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": ["keyword", "storage.type"],
        "settings": { "foreground": "#f33996" }
      },
      {
        "scope": ["entity.name.function", "support.function"],
        "settings": { "foreground": "#39dee4" }
      },
      {
        "scope": "string",
        "settings": { "foreground": "#02ff41" }
      },
      {
        "scope": ["variable", "variable.other"],
        "settings": { "foreground": "#ffffff" }
      },
      {
        "scope": "constant.numeric",
        "settings": { "foreground": "#d0e612" }
      }
    ]
  },

  "editor.fontFamily": "'JetBrains Mono', Consolas, 'Courier New', monospace",
  "editor.fontSize": 14,
  "editor.fontLigatures": true,
  "editor.lineHeight": 1.4,
  "editor.letterSpacing": 0.04,
  "editor.fontWeight": "normal",

  "editor.cursorWidth": 2,
  "editor.cursorBlinking": "blink",
  "editor.cursorSmoothCaretAnimation": "on",

  "editor.renderWhitespace": "none",
  "editor.renderControlCharacters": false,

  "editor.smoothScrolling": true,

  "editor.minimap.enabled": true,
  "editor.minimap.renderCharacters": true,
  "editor.minimap.scale": 1,

  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.wordWrap": "on",
  "editor.lineNumbers": "on",

  "terminal.integrated.fontFamily": "'Fira Code', 'JetBrains Mono', Consolas, 'Courier New', monospace",
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.letterSpacing": 0,

  "files.autoSave": "afterDelay",

  "code-runner.saveFileBeforeRun": true,
  "code-runner.saveAllFilesBeforeRun": true,
  "code-runner.runInTerminal": true,

  "workbench.startupEditor": "none",
  "python.createEnvironment.trigger": "off",
  "workbench.iconTheme": "material-icon-theme",
  "[javascriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "security.workspace.trust.untrustedFiles": "open",
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "markdown-preview-enhanced.codeBlockTheme": "vscode.css",
  "chat.disableAIFeatures": true,
  "workbench.colorTheme": "Material Monokai High Contrast",
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "markdown-preview-enhanced.previewTheme": "github-dark.css",
  "markdown-preview-enhanced.revealjsTheme": "vscode.css",
  "terminal.integrated.mouseWheelZoom": true,
  "explorer.confirmDelete": false,
  "mobile-preview.deviceOptions": [
